generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Evaluation assigned by a staff member to a project.
// Stores the overall grade, optional comments, and the evaluator identity.
// Specific details:
// - `projectId` references a project managed by project-service.
// - `memberUserId`, `memberEventId`, and `memberRoleId` identify the evaluator
//   using the composite key shape from `event-service.StaffEventMember`.
model Evaluation {
  id        Int @id @default(autoincrement())
  projectId Int @map("project_id")

  memberUserId  Int @map("member_user_id")
  memberEventId Int @map("member_event_id")
  memberRoleId  Int @map("member_role_id")

  grade     Float
  comments  String?  @db.Text
  date      DateTime @default(now()) @db.Timestamp()
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamp()

  scores EvaluationDetail[]

  @@map("evaluations")
}

// Junction model between an evaluation and a criterion.
// Stores the score obtained for a specific criterion inside one evaluation.
model EvaluationDetail {
  evaluationId Int        @map("evaluation_id")
  criterionId  Int        @map("criterion_id")
  score        Float
  evaluation   Evaluation @relation(fields: [evaluationId], references: [id])
  criterion    Criterion  @relation(fields: [criterionId], references: [id])

  @@id([evaluationId, criterionId])
  @@map("evaluation_detail")
}

// Evaluation criterion definition.
// Criteria belong to an event and can be reused across multiple evaluations.
// Specific detail:
// - `eventId` references an event managed by event-service.
model Criterion {
  id                   Int                 @id @default(autoincrement())
  eventId              Int                 @map("event_id")
  name                 String              @db.VarChar(100)
  description          String?             @db.Text
  weight               Float
  active               Boolean
  category             String?             @db.VarChar(100)
  createdAt            DateTime            @default(now()) @map("created_at") @db.Timestamp()
  updatedAt            DateTime            @updatedAt @map("updated_at") @db.Timestamp()
  scores               EvaluationDetail[]
  criterionsCategories CriterionCategory[]

  @@map("criterions")
}

// Junction model between criteria and categories.
// Used to associate a criterion with one or more categories.
// Specific detail:
// - `categoryId` references a category managed outside this schema.
model CriterionCategory {
  criterionId Int @map("criterion_id")
  categoryId  Int @map("category_id")

  criterion Criterion @relation(fields: [criterionId], references: [id])

  @@id([criterionId, categoryId])
  @@map("criterions_categories")
}
