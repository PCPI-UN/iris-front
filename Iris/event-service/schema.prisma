generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Supported event types handled by this service.
enum eventType {
  Expo
  Competencia
}

// Main event entity.
// Stores event metadata, scheduling, visibility rules, and high-level ownership.
// Specific detail:
// - `createdByUserId` references a user managed by auth-service.
model Event {
  id                  Int       @id @default(autoincrement())
  name                String    @db.VarChar(255)
  description         String    @db.Text
  accessCode          String    @unique @map("access_code") @db.VarChar(100)
  isPubliclyJoinable  Boolean   @map("is_publicly_joinable")
  inscriptionDeadline DateTime  @map("inscription_deadline") @db.Timestamptz()
  inscriptionCost     Float?    @map("inscription_cost")
  evaluationsOpened   Boolean   @map("evaluations_opened")
  startDate           DateTime  @map("start_date") @db.Timestamptz()
  endDate             DateTime  @map("end_date") @db.Timestamptz()
  active              Boolean   @default(true)
  createdByUserId     Int       @map("created_by_user_id")
  location            String    @db.VarChar(255)
  locationDetails     String?   @db.Text
  eventType           eventType @map("event_type")
  collaborators       String[]  @db.VarChar(255)
  organizers          String[]  @db.VarChar(255)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  participants            StaffEventMember[]
  categories              Category[]
  eventInscriptionDetails EventInscriptionDetail[]
  eventRecaps             EventRecap[]

  @@map("event")
}

// Additional ordered content shown during the inscription process of an event.
// Each record belongs to exactly one event.
model EventInscriptionDetail {
  id          Int      @id @default(autoincrement())
  eventId     Int      @map("event_id")
  title       String   @db.VarChar(255)
  description String?  @db.Text
  detailOrder Int      @default(0) @map("detail_order")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  event Event @relation(fields: [eventId], references: [id])

  @@map("event_inscriptions_details")
}

// Recap or closing summary published after an event finishes.
// Used to expose headlines, summaries, and gallery material.
model EventRecap {
  id             Int      @id @default(autoincrement())
  eventId        Int      @map("event_id")
  headline       String   @db.VarChar(255)
  summary        String?  @db.Text
  closingMessage String?  @map("closing_message") @db.Text
  galeryUrl      String?  @map("galery_url") @db.Text
  published      Boolean  @default(false)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  event Event @relation(fields: [eventId], references: [id])

  @@map("event_recaps")
}

// Join model between an event and a staff user.
// Stores membership state and the role assigned within the event.
// Specific details:
// - `userId` references `auth-service.users`.
// - `roleId` references `auth-service.roles`.
// - The composite primary key prevents duplicate membership per event.
model StaffEventMember {
  userId    Int      @map("user_id")
  eventId   Int      @map("event_id")
  roleId    Int      @map("role_id")
  active    Boolean
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  event Event @relation(fields: [eventId], references: [id])

  @@id([userId, eventId])
  @@map("event_members")
}

// Event category definition.
// Categories group projects or participants inside a specific event.
// Specific detail:
// - `name` is globally unique in the current schema, not unique per event.
model Category {
  id          Int      @id @default(autoincrement())
  eventId     Int      @map("event_id")
  name        String   @unique @db.VarChar(255)
  description String?  @db.Text
  active      Boolean  @default(true) @map("active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  event          Event                @relation(fields: [eventId], references: [id])
  categoryAwards AwardCategoryEvent[]

  @@map("categories")
}

// Award definition attached to a category.
// Represents prizes or placements such as first place, second place, and so on.
model AwardCategoryEvent {
  id          Int      @id @default(autoincrement())
  categoryId  Int      @map("category_id")
  title       String   @db.VarChar(255)
  description String?  @db.Text
  value       Float?
  position    Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  category          Category           @relation(fields: [categoryId], references: [id])
  awardWinnerEvents AwardWinnerEvent[]

  @@map("category_awards")
}

// Winner assignment for a category award.
// Links a specific award with the winning project and its final score.
// Specific details:
// - `projectId` references `project-service.projects`.
// - `assignedByUserId` references a user managed by auth-service.
model AwardWinnerEvent {
  id               Int      @id @default(autoincrement())
  awardId          Int      @map("award_id")
  projectId        Int      @map("project_id")
  grade            Float
  createdAt        DateTime @default(now()) @map("assigned_at") @db.Timestamptz()
  assignedByUserId Int      @map("assigned_by_user_id")

  award AwardCategoryEvent @relation(fields: [awardId], references: [id])

  @@map("award_winners")
}
