      "id": "event-bloc-2026",
      "title": "BLOC 2026 - GRIP SHIPPING BUSINESS LOGISTICS OPTIMIZATION CHALLENGE",
      "description": "Un desafío estilo hackatón de 48 horas continuas enfocado en la optimización de decisiones logísticas empresariales, mediante pronóstico de demanda, diseño de políticas de inventario y evaluación de impacto económico. Los equipos desarrollarán una solución técnica robusta y una propuesta ejecutiva aplicable a un caso real de distribución en Estados Unidos propuesto por GRIP Shipping.",
      "startDate": "2026-04-24T16:00:00",
      "endDate": "2026-04-26T16:00:00",
      "inscriptionDeadline": "2026-03-30",
      "accessCode": "BLOC2026",
      "isPublic": true,
      "evaluationsStatus": "open",
      "createdAt": 1740000000000,
      "location": {
        "venue": "Salas de usuarios – Piso 5, Bloque K (Edificio de Ingenierías)",
        "institution": "Universidad del Norte",
        "city": "Km. 5 vía Puerto Colombia"
      },
      "organization": "Universidad del Norte",
      "company": "GRIP Shipping",
      "eventType": "hackathon",
      "cost": "free",
      "spotsAvailable": true,
      "sponsors": [
        {
          "name": "GRIP Shipping",
          "logoSrc": "/Grip-Logo-final-blanco.gif",
          "url": "https://gripshipping.com"
        },
        {
          "name": "Uninorte 60",
          "logoSrc": "/Logo60-Uninorte.png",
          "url": "https://www.uninorte.edu.co"
        }
      ],
      "prizeConfig": {
        "currency": "COP",
        "items": [
          {
            "position": 1,
            "amount": 2000000
          },
          {
            "position": 2,
            "amount": 1000000
